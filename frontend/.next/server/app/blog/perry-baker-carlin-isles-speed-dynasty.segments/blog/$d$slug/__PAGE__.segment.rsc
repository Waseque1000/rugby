27:["$","div",null,{"className":"relative w-full aspect-[16/9] sm:aspect-[21/9] rounded-3xl overflow-hidden border border-border shadow-md my-6","children":[["$","$L31",null,{"src":"/images/blog/perry-baker-carlin-isles.jpg","alt":"The Speed Dynasty: Perry Baker, Carlin Isles, and the Evolution of the American Wing","fill":true,"priority":true,"className":"object-cover","sizes":"(max-width: 896px) 100vw, 896px"}],["$","div",null,{"className":"absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"}],["$","div",null,{"className":"absolute bottom-3 left-4 right-4 text-[11px] text-white/90 drop-shadow flex items-center justify-between","children":[["$","span",null,{"children":"Official Action & Tournament Photography"}],["$","span",null,{"className":"text-[10px] bg-black/40 px-2 py-0.5 rounded backdrop-blur-xs","children":"Source: Bing Search Archive"}]]}]]}]
