39:["$","article",null,{"className":"bg-card border border-border rounded-3xl p-6 sm:p-12 shadow-xs prose dark:prose-invert max-w-none","children":[["$","h1","1",{"className":"text-2xl sm:text-3xl font-black text-foreground mt-8 mb-4 tracking-tight","children":"Sevens vs. Fifteens: The Science of High-Velocity Rugby"}],["$","p","3",{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed my-4","children":"To the casual observer, Rugby Sevens looks like rugby played on fast-forward. But beneath the jaw-dropping line breaks and acrobatic dives lies a game governed by completely different physiological and tactical rules."}],["$","h2","5",{"className":"text-xl sm:text-2xl font-bold text-foreground mt-8 mb-3 tracking-tight border-b border-border/50 pb-2","children":"The Field Paradox: Vast Open Space"}],["$","p","7",{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed my-4","children":"In traditional Rugby Union (15s), thirty players share a pitch roughly 100 meters long by 70 meters wide. Defenses operate in tight, organized walls with multiple defensive pods and sweepers covering kicks."}],["$","p","9",{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed my-4","children":"In Rugby Sevens:"}],["$","ul","ul-14",{"className":"list-disc list-inside space-y-2 my-4 text-muted-foreground","children":[["$","li","10",{"className":"leading-relaxed","children":"Only **14 players total** share that exact same 7,000 square-meter pitch."}],["$","li","11",{"className":"leading-relaxed","children":"Each player is responsible for defending an astronomical **500 square meters** of open turf."}],["$","li","12",{"className":"leading-relaxed","children":"A single missed one-on-one tackle almost always results in a conceded 5-point try."}]]}],["$","h2","14",{"className":"text-xl sm:text-2xl font-bold text-foreground mt-8 mb-3 tracking-tight border-b border-border/50 pb-2","children":"Physiological Demands: Heart Rates Near Maximum"}],["$","p","16",{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed my-4","children":"Sevens matches consist of two intense 7-minute halves with a brief 2-minute halftime interval. GPS tracking data from international squads reveals staggering physiological loads:"}],["$","ul","ul-22",{"className":"list-disc list-inside space-y-2 my-4 text-muted-foreground","children":[["$","li","18",{"className":"leading-relaxed","children":"**Sprint Distance**: Players log between 1,200m and 1,800m of sprint and high-speed running per 14-minute match."}],["$","li","19",{"className":"leading-relaxed","children":"**Heart Rate**: Average heart rates consistently exceed 88% to 94% of maximum heart rate throughout the contest."}],["$","li","20",{"className":"leading-relaxed","children":"**Metabolic Acidosis**: Lactate levels peak dramatically because there is no prolonged recovery between collisions."}]]}],["$","h2","22",{"className":"text-xl sm:text-2xl font-bold text-foreground mt-8 mb-3 tracking-tight border-b border-border/50 pb-2","children":"Key Rule & Tactical Differences"}],["$","h3","24",{"className":"text-lg font-bold text-foreground mt-6 mb-2","children":"1. Three-Player Scrums"}],["$","p","25",{"className":"text-base sm:text-lg text-muted-foreground leading-relaxed my-4","children":"Unlike the 8-player scrums of fifteens that involve over 1,600 pounds of combined force, Sevens scrums feature only 3 players per side (two props and a hooker). In Sevens, the scrum is an attacking launchpad rather than a contest of pure attrition."}],["$","h3","27",{"className":"text-lg font-bold text-foreground mt-6 mb-2","children":"2. Conversions by Drop-Kick"}],"$L43","$L44","$L45"]}]
