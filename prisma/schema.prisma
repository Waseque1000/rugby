datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id              String   @id
  slug            String   @unique
  name            String
  age             Int?
  dob             String?
  team            String?
  format          String?
  position        String?
  hometown        String?
  hometownState   String?  @map("hometown_state")
  nationality     String?
  height          String?
  weight          String?
  club            String?
  college         String?
  debut           String?
  nationalYears   String?  @map("national_years")
  caps            Int?
  tries           Int?
  points          Int?
  fifteensCaps    Int?     @map("fifteens_caps")
  olympicGames    String?  @map("olympic_games")
  isOlympian      Boolean  @default(false) @map("is_olympian")
  olympicEditions String[] @map("olympic_editions")
  worldCupSevens  String?  @map("world_cup_sevens")
  achievements    String?
  biography       String?
  imageUrl        String?  @map("image_url")
  imageAlt        String?  @map("image_alt")
  sourceUrl       String?  @map("source_url")
  sourceNotes     String?  @map("source_notes")
  dataStatus      String?  @map("data_status")
  lastChecked     String?  @map("last_checked")
  rawData         Json?    @map("raw_data")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([team])
  @@index([position])
  @@index([college])
  @@index([isOlympian])
  @@index([hometownState])
  @@map("players")
}

model Source {
  id        Int      @id @default(autoincrement())
  source    String
  url       String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sources")
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}
